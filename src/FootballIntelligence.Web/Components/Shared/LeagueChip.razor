<span class="league-chip" title="@Fmt.CompetitionName(Code)"><span class="league-dot" style="background:@Fmt.LeagueColor(Code)"></span>@if (ShowCountry && Fmt.Country(Code) != "") {<Flag Country="@Fmt.Country(Code)" />}@(Short ? Code : Fmt.CompetitionName(Code))</span>

@code {
    [Parameter, EditorRequired] public string Code { get; set; } = "";
    [Parameter] public bool Short { get; set; }
    [Parameter] public bool ShowCountry { get; set; } = true;
}
