@page "/matches"
@inject FootballQueries Football

<PageTitle>Matches · Football Intelligence</PageTitle>

<div class="page-head">
    <div>
        <h1>Matches</h1>
        <p>Upcoming fixtures with forward predictions and historical matches with their walk-forward (leakage-free) predictions.</p>
    </div>
</div>

<div class="card">
    <div class="row">
        <select class="input" @bind="competition" @bind:after="Load">
            <option value="">All competitions</option>
            @foreach (var c in competitions) { <option value="@c">@Fmt.CompetitionName(c)</option> }
        </select>
        <select class="input" @bind="season" @bind:after="Load">
            <option value="">All seasons</option>
            @for (var s = 2026; s >= 2005; s--) { <option value="@s">@s/@((s + 1) % 100)</option> }
        </select>
        <input class="input" placeholder="Search team (e.g. Manchester)" @bind="team" @bind:event="oninput" @bind:after="Load" />
        @if (view == "date")
        {
            <button class="btn sm" @onclick="() => Shift(-1)">‹</button>
            <input class="input" type="date" @bind="day" @bind:after="Load" />
            <button class="btn sm" @onclick="() => Shift(1)">›</button>
            <button class="btn sm" @onclick="() => { day = DateTime.Today; Load(); }">Today</button>
        }
        <div class="tabs" style="border:none">
            <button class="tab @(view == "upcoming" ? "active" : "")" @onclick='() => SetView("upcoming")'>Upcoming</button>
            <button class="tab @(view == "results" ? "active" : "")" @onclick='() => SetView("results")'>Results</button>
            <button class="tab @(view == "date" ? "active" : "")" @onclick='() => SetView("date")'>By date</button>
        </div>
    </div>
    @if (view == "date")
    {
        <div class="day-strip">
            @for (var i = -3; i <= 3; i++)
            {
                var d = day.AddDays(i);
                <button class="day @(d == day ? "active" : "")" @onclick="() => { day = d; Load(); }">
                    <span>@(d == DateTime.Today ? "Today" : d.ToString("ddd", System.Globalization.CultureInfo.InvariantCulture))</span>
                    <b>@d.ToString("dd MMM", System.Globalization.CultureInfo.InvariantCulture)</b>
                </button>
            }
        </div>
    }
    <div class="league-filter">
        <button class="lf @(competition == "" ? "active" : "")" @onclick='() => SetCompetition("")'>All leagues</button>
        @foreach (var c in competitions)
        {
            <button class="lf @(competition == c ? "active" : "")" @onclick="() => SetCompetition(c)"><LeagueChip Code="@c" /></button>
        }
    </div>
    @if (teams.Count > 0)
    {
        <div class="team-chips">
            @foreach (var t in teams)
            {
                <a class="team-chip" href="team/@t.TeamId"><Crest Name="@t.Name" TeamId="@t.TeamId" />@t.Name<span class="small faint">@(t.Competition is null ? "" : Fmt.CompetitionName(t.Competition))</span></a>
            }
        </div>
    }
</div>

<div class="card matches-list">
    <div class="card-head">
        <h2>@(view == "upcoming" ? "Upcoming fixtures" : view == "date" ? day.ToString("dddd dd MMMM yyyy") : "Results")</h2>
        <span class="sub">@rows.Count matches shown</span>
    </div>
    @if (rows.Count == 0) { <div class="empty">No matches for these filters@(view == "date" ? " on this date" : ""). Try another league, date or team name.</div> }
    @foreach (var day in rows.GroupBy(m => m.MatchDate))
    {
        <div class="day-head">@DateTime.Parse(day.Key, System.Globalization.CultureInfo.InvariantCulture).ToString("dddd dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
        @foreach (var league in day.GroupBy(m => m.Competition))
        {
            <div class="league-head"><LeagueChip Code="@league.Key" /><span class="small faint">@league.Count()</span></div>
            @foreach (var m in league) { <MatchLine Match="m" ShowDate="false" /> }
        }
    }
</div>

@code {
    private List<string> competitions = [];
    private string competition = "";
    private string season = "";
    private string team = "";
    private string view = "upcoming";
    private DateTime day = DateTime.Today;

    private void Shift(int days)
    {
        day = day.AddDays(days);
        Load();
    }
    private List<MatchRow> rows = [];
    private List<TeamInfo> teams = [];

    protected override void OnInitialized()
    {
        competitions = Football.Competitions().OrderBy(c => Array.IndexOf(["E0", "SP1", "D1", "I1", "F1"], c) is var i && i < 0 ? 99 : i).ToList();
        Load();
        if (rows.Count == 0) SetView("results");
    }

    private void SetCompetition(string c)
    {
        competition = c;
        Load();
    }

    private void SetView(string v)
    {
        view = v;
        Load();
    }

    private void Load()
    {
        string? comp = string.IsNullOrEmpty(competition) ? null : competition;
        teams = team.Trim().Length >= 3 ? Football.FindTeams(team.Trim(), 8) : [];
        if (view == "date")
        {
            rows = Football.OnDate(day.ToString("yyyy-MM-dd")).Where(m => (string.IsNullOrEmpty(competition) || m.Competition == competition)
                && (string.IsNullOrEmpty(team) || m.HomeName.Contains(team, StringComparison.OrdinalIgnoreCase) || m.AwayName.Contains(team, StringComparison.OrdinalIgnoreCase))).ToList();
        }
        else if (view == "upcoming")
        {
            rows = Football.Upcoming(150, comp).Where(m => string.IsNullOrEmpty(team) || m.HomeName.Contains(team, StringComparison.OrdinalIgnoreCase) || m.AwayName.Contains(team, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        else
        {
            rows = Football.Search(comp, long.TryParse(season, out var s) ? s : null, string.IsNullOrWhiteSpace(team) ? null : team, 150)
                .Where(m => m.Status == "finished").ToList();
        }
    }
}
