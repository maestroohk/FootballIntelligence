<svg class="flag" viewBox="0 0 18 12" role="img" aria-label="@Country"><title>@Country</title>
    @switch (Country)
    {
        case "ENG": <rect width="18" height="12" fill="#fff" /><rect x="7.5" width="3" height="12" fill="#ce1124" /><rect y="4.5" width="18" height="3" fill="#ce1124" /> break;
        case "SCO": <rect width="18" height="12" fill="#005eb8" /><path d="M0 0L18 12M18 0L0 12" stroke="#fff" stroke-width="2.2" /> break;
        case "ESP": <rect width="18" height="12" fill="#aa151b" /><rect y="3" width="18" height="6" fill="#f1bf00" /> break;
        case "GER": <rect width="18" height="4" fill="#000" /><rect y="4" width="18" height="4" fill="#dd0000" /><rect y="8" width="18" height="4" fill="#ffce00" /> break;
        case "ITA": <rect width="6" height="12" fill="#009246" /><rect x="6" width="6" height="12" fill="#fff" /><rect x="12" width="6" height="12" fill="#ce2b37" /> break;
        case "FRA": <rect width="6" height="12" fill="#002395" /><rect x="6" width="6" height="12" fill="#fff" /><rect x="12" width="6" height="12" fill="#ed2939" /> break;
        case "NED": <rect width="18" height="4" fill="#ae1c28" /><rect y="4" width="18" height="4" fill="#fff" /><rect y="8" width="18" height="4" fill="#21468b" /> break;
        case "POR": <rect width="18" height="12" fill="#da291c" /><rect width="7.2" height="12" fill="#046a38" /><circle cx="7.2" cy="6" r="2.2" fill="#ffe900" /> break;
        case "BEL": <rect width="6" height="12" fill="#000" /><rect x="6" width="6" height="12" fill="#fdda24" /><rect x="12" width="6" height="12" fill="#ef3340" /> break;
        case "TUR": <rect width="18" height="12" fill="#e30a17" /><circle cx="6.8" cy="6" r="3" fill="#fff" /><circle cx="7.6" cy="6" r="2.4" fill="#e30a17" /><circle cx="10.6" cy="6" r="1" fill="#fff" /> break;
        case "GRE": <rect width="18" height="12" fill="#0d5eaf" /><path d="M0 2h18M0 4.7h18M0 7.3h18M0 10h18" stroke="#fff" stroke-width="1.33" /><rect width="6.7" height="6.7" fill="#0d5eaf" /><path d="M3.35 0v6.7M0 3.35h6.7" stroke="#fff" stroke-width="1.33" /> break;
        default: <rect width="18" height="12" fill="#5b6b80" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Country { get; set; } = "";
}
