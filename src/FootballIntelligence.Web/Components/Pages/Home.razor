@page "/"
@inherits FeedComponent
@inject FootballQueries Football
@inject ResearchQueries Research
@inject OperationsQueries Ops
@inject ViewMode Mode
@inject IJSRuntime JS

<PageTitle>Overview · Football Intelligence</PageTitle>

<div class="page-head">
    <div>
        <h1>@(today.Count > 0 ? "Today's football" : "Football")</h1>
        <p>@DateTime.Today.ToString("dddd d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture) · predictions are made before kick-off and never changed afterwards.</p>
    </div>
    <div class="row">
        <a class="btn" href="matches">All matches →</a>
    </div>
</div>

@if (!engineReady)
{
    <div class="callout warn">The prediction engine is not fully restored on this computer, so some matches have no forecast. Those matches say so; nothing is estimated in its place. <a href="data">Details</a></div>
}

<div class="grid g-main-side">
    <div class="stack" style="gap:16px">
        <div class="card">
            <div class="card-head">
                <h2>@(today.Count > 0 ? "Today" : nextDay is null ? "Upcoming" : $"Next matches · {DayLabel(nextDay)}")</h2>
                <span class="sub">@((today.Count > 0 ? today : nextMatches).Count) matches</span>
            </div>
            @if (today.Count == 0 && nextMatches.Count == 0)
            {
                <div class="empty">No upcoming fixtures are known yet. The fixture list refreshes with each update cycle.</div>
            }
            @foreach (var league in (today.Count > 0 ? today : nextMatches).GroupBy(m => m.Competition).OrderBy(g => LeagueOrder(g.Key)))
            {
                <div class="league-head"><LeagueChip Code="@league.Key" /><span class="small faint">@league.Count()</span></div>
                @foreach (var m in league.Take(8)) { <MatchLine Match="m" ShowDate="false" /> }
            }
        </div>

        @if (featured.Count > 0)
        {
            <div class="card">
                <div class="card-head"><h2>Featured predictions</h2><span class="sub">top-division fixtures in the next week</span></div>
                <div class="featured">
                    @foreach (var (m, tag) in featured)
                    {
                        var homeFav = m.PHome >= m.PAway;
                        <a class="feat" href="matches/@m.MatchId">
                            <div class="spread small"><LeagueChip Code="@m.Competition" /><span class="faint">@DayLabel(m.MatchDate) @m.Kickoff</span></div>
                            <div class="feat-teams">
                                <span class="feat-team"><Crest Name="@m.HomeName" TeamId="@m.HomeTeamId" /><span>@m.HomeName</span></span>
                                <span class="feat-vs">vs</span>
                                <span class="feat-team"><Crest Name="@m.AwayName" TeamId="@m.AwayTeamId" /><span>@m.AwayName</span></span>
                            </div>
                            <div class="feat-odds"><span>@Fmt.Pct(m.PHome)</span><span>Draw @Fmt.Pct(m.PDraw)</span><span>@Fmt.Pct(m.PAway)</span></div>
                            <ProbBar Home="m.PHome!.Value" Draw="m.PDraw!.Value" Away="m.PAway!.Value" Slim="true" />
                            <div class="feat-tag">@tag · @(tag == "Closest contest" ? $"favourite only {Fmt.Pct(Math.Max(m.PHome!.Value, m.PAway!.Value))}" : $"{(homeFav ? m.HomeName : m.AwayName)} {Fmt.Pct(Math.Max(m.PHome!.Value, m.PAway!.Value))}")</div>
                        </a>
                    }
                </div>
            </div>
        }

        <div class="card">
            <div class="card-head"><h2>Recent results</h2><span class="sub">with the prediction stored for each match</span></div>
            @if (recent.Count == 0) { <div class="empty">No results in the database yet.</div> }
            @foreach (var m in recent.Take(8)) { <MatchLine Match="m" /> }
        </div>
    </div>

    <div class="stack" style="gap:16px">
        <div class="card">
            <div class="card-head"><h2>Your teams</h2><span class="sub">follow a team from its page</span></div>
            @if (followed.Count == 0)
            {
                <div class="small dim">You are not following any teams yet. Open a team and choose Follow to see its next match here.</div>
            }
            @foreach (var (t, next) in followed)
            {
                <a class="spread follow-row" href="@(next is null ? $"team/{t.TeamId}" : $"matches/{next.MatchId}")">
                    <span class="row" style="gap:8px;min-width:0"><Crest Name="@t.Name" TeamId="@t.TeamId" /><span class="ellipsis">@t.Name</span></span>
                    <span class="small dim">@(next is null ? "no fixture known" : $"{(next.HomeTeamId == t.TeamId ? "v " + next.AwayName : "at " + next.HomeName)} · {DayLabel(next.MatchDate)}")</span>
                </a>
            }
        </div>
        <div class="card">
            <div class="card-head"><h2>How the predictions are doing</h2><a href="learning" class="small">Learning →</a></div>
            @if (forwardRecord.N == 0)
            {
                <div class="small dim">No pre-match forecast has been scored against a final result on this computer yet.@(backtestRecord.N > 0 ? $" Historical re-forecasts: the most likely result happened in {Fmt.Pct((double)backtestRecord.TopPickHits / backtestRecord.N)} of {backtestRecord.N:N0} matches." : "")</div>
            }
            else
            {
                <div class="fan-facts">
                    <div><span class="value">@forwardRecord.N.ToString("N0")</span><span class="label">pre-match forecasts scored</span></div>
                    <div><span class="value">@Fmt.Pct((double)forwardRecord.TopPickHits / forwardRecord.N)</span><span class="label">most likely result happened</span></div>
                </div>
                <div class="small faint" style="margin-top:8px">Hit rate alone does not show whether probabilities are well judged; the Learning page tracks calibration and log loss against baselines.</div>
            }
        </div>
        <div class="card">
            <div class="card-head"><h2>Data freshness</h2><a href="data" class="small">Data health →</a></div>
            <div class="spread small" style="padding:4px 0"><span class="dim">Latest result</span><span>@(latestResult ?? "none")</span></div>
            <div class="spread small" style="padding:4px 0"><span class="dim">Future fixtures known</span><span>@upcoming.Count</span></div>
            <div class="spread small" style="padding:4px 0"><span class="dim">Prediction engine</span><span class="@(engineReady ? "" : "warn")">@(engineReady ? "ready" : "not restored")</span></div>
            @foreach (var p in providers)
            {
                <div class="spread small" style="padding:4px 0">
                    <span class="row"><span class="dot @(p.Status == "ok" ? "ok" : p.Status == "not_configured" ? "warn" : "bad")"></span>@p.Provider</span>
                    <span class="dim">@(p.LastSuccess is null ? p.Status : Fmt.Ago(p.LastSuccess))</span>
                </div>
            }
        </div>
        <div class="card">
            <div class="card-head"><h2>Live matches</h2><a href="live" class="small">Live tracker →</a></div>
            @if (live.Count == 0)
            {
                <div class="small dim">No live score feed is connected. Past matches can be replayed minute by minute in the Live tracker, always labelled REPLAY.</div>
            }
            @foreach (var l in live.Take(5))
            {
                <div class="spread" style="padding:6px 0">
                    <a href="live/@l.LiveId">@l.HomeName @l.HomeGoals – @l.AwayGoals @l.AwayName</a>
                    <span class="row"><span class="badge @(l.Mode == "replay" ? "sim" : "bad")">@(l.Mode == "replay" ? "REPLAY" : "LIVE")</span><span class="small dim">@Fmt.Minute(l.Minute ?? 0)</span></span>
                </div>
            }
        </div>
    </div>
</div>

@if (Mode.Analyst)
{
    <div class="grid g4">
        <Kpi Label="Champion model" Value="@Fmt.ModelLabel(champion)" Note="@championNote" />
        <Kpi Label="Validation log loss" Value="@Fmt.Num(championVal?.GetProperty("log_loss").GetDouble(), 4)" Note="@($"vs bookmaker close {Fmt.Num(bookVal?.GetProperty("log_loss").GetDouble(), 4)} · n={championVal?.GetProperty("n").GetInt64()}")" />
        <Kpi Label="Forward predictions" Value="@upcoming.Count(u => u.PHome is not null && u.Purpose == "forward" && u.PredictionFlag is null).ToString()" Note="@($"stored ≥3 h before kick-off · {upcoming.Count} future fixtures known")" />
        <Kpi Label="Forward log loss" Value="@Fmt.Num(forwardRecord.LogLoss, 4)" Note="@($"{forwardRecord.N} scored pre-match forecasts")" />
    </div>
    <div class="card">
        <div class="card-head"><h2>Model performance</h2><a href="lab" class="small">Model lab →</a></div>
        @if (perfRows.Count == 0) { <div class="empty">No backtest has been run on this computer.</div> }
        else
        {
            <table class="data">
                <thead><tr><th></th><th class="num">n</th><th class="num">Log loss</th><th class="num">ECE</th></tr></thead>
                <tbody>
                    @foreach (var (label, el) in perfRows)
                    {
                        <tr><td class="small">@label.Split('|')[0]<div class="faint">@label.Split('|')[1]</div></td><td class="num small">@el.GetProperty("n").GetInt64().ToString("N0")</td><td class="num">@el.GetProperty("log_loss").GetDouble().ToString("F4")</td><td class="num small">@el.GetProperty("ece").GetDouble().ToString("F4")</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private List<MatchRow> upcoming = [];
    private List<MatchRow> today = [];
    private List<MatchRow> nextMatches = [];
    private string? nextDay;
    private List<(MatchRow, string)> featured = [];
    private List<(TeamInfo, MatchRow?)> followed = [];
    private List<long> followIds = [];
    private TrackRecord forwardRecord = new();
    private TrackRecord backtestRecord = new();
    private string? latestResult;
    private bool engineReady;
    private List<MatchRow> recent = [];
    private List<LiveSessionRow> live = [];
    private List<ProviderRow> providers = [];
    private ProviderRow? liveProvider;
    private string? champion;
    private string championNote = "";
    private JsonElement? championVal;
    private JsonElement? bookVal;
    private List<(string, JsonElement)> perfRows = [];

    protected override bool ShouldRefresh(FeedState previous, FeedState next) => previous.JobStatuses != next.JobStatuses || previous.MaxSnapshotId != next.MaxSnapshotId;

    protected override void Load()
    {
        upcoming = Football.Upcoming(500);
        today = Football.OnDate(DateTime.Today.ToString("yyyy-MM-dd"));
        nextDay = upcoming.FirstOrDefault()?.MatchDate;
        nextMatches = nextDay is null ? [] : upcoming.Where(m => m.MatchDate == nextDay).ToList();
        var week = DateTime.Today.AddDays(8).ToString("yyyy-MM-dd");
        var candidates = upcoming.Where(m => m.PHome is not null && string.CompareOrdinal(m.MatchDate, week) < 0 && LeagueOrder(m.Competition) < 5).ToList();
        featured = [];
        foreach (var m in candidates.OrderByDescending(m => Math.Max(m.PHome!.Value, m.PAway!.Value)).Take(2)) featured.Add((m, "Clearest favourite"));
        foreach (var m in candidates.Where(c => featured.All(f => f.Item1.MatchId != c.MatchId)).OrderBy(m => Math.Abs(m.PHome!.Value - m.PAway!.Value)).Take(2)) featured.Add((m, "Closest contest"));
        forwardRecord = Football.Record("forward");
        backtestRecord = Football.Record("backtest");
        latestResult = Football.Recent(1).FirstOrDefault()?.MatchDate;
        engineReady = Ops.Assets() is { } assets && assets.GetProperty("operational").GetBoolean();
        LoadFollowed();
        recent = Football.Recent(10);
        live = Ops.LiveSessions(10).Where(l => l.Status == "running").ToList();
        providers = Ops.Providers();
        liveProvider = providers.FirstOrDefault(p => p.Provider.Contains("live"));
        champion = Research.Champion();
        var champRun = champion is null ? null : Research.Backtest(champion.Split('@')[0], "validation");
        championVal = champRun is null ? null : JsonDocument.Parse(champRun.Metrics).RootElement.Clone();
        var book = Research.Backtest("bookmaker_close", "validation");
        bookVal = book is null ? null : JsonDocument.Parse(book.Metrics).RootElement.Clone();
        championNote = champRun is null ? "Run the research job to select a champion" : $"validation {champRun.TestPeriod}";
        perfRows = [];
        foreach (var (split, label) in new[] { ("validation", "validation 2012–23"), ("final_test", "final test 2023–26") })
        {
            foreach (var model in new[] { champion?.Split('@')[0] ?? "ensemble", "dixon_coles", "bookmaker_close" })
            {
                var run = Research.Backtest(model, split);
                if (run is not null) perfRows.Add(($"{Fmt.ModelLabel(model).Replace(" (benchmark)", "")}|{label}", JsonDocument.Parse(run.Metrics).RootElement.Clone()));
            }
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Mode.Changed += OnMode;
    }

    private void OnMode() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        Mode.Changed -= OnMode;
        base.Dispose();
    }

    private void LoadFollowed() => followed = followIds.Select(id => Football.Team(id)).OfType<TeamInfo>()
        .Select(t => (t, Football.TeamMatches(t.TeamId, "scheduled", 5).FirstOrDefault(m => string.CompareOrdinal(m.MatchDate, DateTime.Today.ToString("yyyy-MM-dd")) >= 0))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", "fi-follow");
            followIds = string.IsNullOrEmpty(raw) ? [] : JsonSerializer.Deserialize<List<long>>(raw) ?? [];
        }
        catch (Exception ex) when (ex is JSException or JsonException) { followIds = []; }
        if (followIds.Count == 0) return;
        LoadFollowed();
        StateHasChanged();
    }

    private static int LeagueOrder(string code) => Array.IndexOf(["E0", "SP1", "D1", "I1", "F1"], code) is var i && i >= 0 ? i : 9;

    private static string DayLabel(string? date)
    {
        if (date is null) return "";
        var d = DateTime.Parse(date, System.Globalization.CultureInfo.InvariantCulture);
        var today = DateTime.Today;
        var name = d == today ? "Today" : d == today.AddDays(1) ? "Tomorrow" : d.ToString("dddd", System.Globalization.CultureInfo.InvariantCulture);
        return $"{name} · {d:dd MMM}";
    }
}
