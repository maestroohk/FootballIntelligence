<a class="fixture" href="matches/@Match.MatchId">
    <div class="fx-status">
        @if (Match.Status == "finished") { <span class="fx-ft">FT</span> }
        else if (AwaitingResult) { <span class="fx-wait" title="Kick-off has passed; waiting for the result source">Result due</span> }
        else { <span class="fx-time">@(Match.Kickoff ?? "TBC")</span> }
        <span class="fx-date">@ShortDate</span>
    </div>
    <div class="fx-teams">
        <div class="fx-team @(Match.Result == "H" ? "win" : "")"><Crest Name="@Match.HomeName" TeamId="@Match.HomeTeamId" /><span class="fx-name">@Match.HomeName</span><span class="fx-goals">@Match.Fthg</span></div>
        <div class="fx-team @(Match.Result == "A" ? "win" : "")"><Crest Name="@Match.AwayName" TeamId="@Match.AwayTeamId" /><span class="fx-name">@Match.AwayName</span><span class="fx-goals">@Match.Ftag</span></div>
    </div>
    <div class="fx-pred">
        @if (Match.PHome is not null)
        {
            <div class="fx-odds">
                <span class="@(Top == 0 ? "top" : "")"><small>1</small>@Fmt.Pct(Match.PHome)</span>
                <span class="@(Top == 1 ? "top" : "")"><small>X</small>@Fmt.Pct(Match.PDraw)</span>
                <span class="@(Top == 2 ? "top" : "")"><small>2</small>@Fmt.Pct(Match.PAway)</span>
            </div>
            <ProbBar Home="Match.PHome.Value" Draw="Match.PDraw!.Value" Away="Match.PAway!.Value" Slim="true" />
            <div class="fx-meta">
                <span>xG @Fmt.Num(Match.LambdaHome, 1)–@Fmt.Num(Match.LambdaAway, 1)</span>
                <span title="@Match.PredictionFlag">@(Match.PredictionFlag is not null ? "late · not evaluated" : Match.Purpose == "forward" ? "pre-match forecast" : "backtest")</span>
            </div>
        }
        else
        {
            <span class="fx-meta">No stored prediction</span>
        }
    </div>
</a>

@code {
    [Parameter, EditorRequired] public MatchRow Match { get; set; } = default!;
    [Parameter] public bool ShowDate { get; set; } = true;

    private int Top => Match.PHome is null ? -1 : Match.PHome >= Match.PDraw && Match.PHome >= Match.PAway ? 0 : Match.PDraw >= Match.PAway ? 1 : 2;
    private string ShortDate => ShowDate && DateTime.TryParse(Match.MatchDate, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var d) ? d.ToString("dd MMM", System.Globalization.CultureInfo.InvariantCulture) : "";
    private bool AwaitingResult => Match.Status == "scheduled" && DateTime.TryParse($"{Match.MatchDate} {Match.Kickoff ?? "23:59"}", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var k) && k.AddHours(2.5) < DateTime.Now;
}
